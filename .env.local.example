# ── Audit form delivery ───────────────────────────────────────────────
# To capture "Book a free audit" submissions automatically (no email-client
# step), create a free form at https://formspree.io connected to
# dglabs.van@gmail.com, then paste its endpoint URL below and rename this
# file to ".env.local" (then restart `npm run dev` / rebuild).
#
# Until this is set, the form falls back to opening the visitor's email app
# pre-addressed to dglabs.van@gmail.com.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
